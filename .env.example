# Typed config (see src/config/env.py): every key is namespaced
# APP_RUN__<SECTION>__<FIELD>. docker-compose.yml interpolates the same
# ${APP_RUN__...} names, so this file is the single source of truth for
# both the Django app and the containers around it (e.g. Postgres's own
# credentials).

APP_RUN__DJANGO_SETTINGS__SECRET_KEY=change-me
APP_RUN__DJANGO_SETTINGS__DEBUG=1
APP_RUN__DJANGO_SETTINGS__ALLOWED_HOSTS=*
APP_RUN__DJANGO_SETTINGS__PORT=8000

APP_RUN__DATABASE__HOST=db
APP_RUN__DATABASE__PORT=5432
APP_RUN__DATABASE__NAME=agent_factory
APP_RUN__DATABASE__USER=agent_factory
APP_RUN__DATABASE__PASSWORD=agent_factory

APP_RUN__KAFKA__BOOTSTRAP_SERVERS=kafka:9092

# Created by the `init` container on first boot if a password is set here;
# leave the password blank to skip superuser creation entirely.
APP_RUN__SUPERUSER__USERNAME=admin
APP_RUN__SUPERUSER__EMAIL=admin@example.com
APP_RUN__SUPERUSER__PASSWORD=change-me-too

# Leave blank to default to <repo>/generated_teams
APP_RUN__PATHS__GENERATED_TEAMS_ROOT=
